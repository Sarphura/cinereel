{
  "name": "@cinereel/hyper-sdk",
  "version": "0.0.1",
  "description": "CineReel hyper SDK wrapper (Corestore / Hyperdrive / Hyperswarm) with runtime + service factory surface.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "corestore": "^7.11.1",
    "hypercore": "^11.0.0",
    "hyperdrive": "^13.3.3",
    "hyperswarm": "^4.7.0"
  },
  "peerDependencies": {
    "hyperdht": "^6.30.0"
  },
  "peerDependenciesMeta": {
    "hyperdht": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "hyperdht": "^6.30.0",
    "typescript": "^5.9.3"
  }
}
