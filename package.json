{
  "name": "cinereel",
  "version": "0.0.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n bootstrap,ui,service \"pnpm run dev:bootstrap\" \"pnpm run dev:ui\" \"pnpm run dev:service\"",
    "dev:peer": "concurrently \"pnpm run dev:ui:peer\" \"pnpm run dev:service:peer\"",
    "build:start": "pnpm run build && pnpm run start",
    "test": "pnpm run test:service",
    
    "dev:bootstrap": "pnpm --filter @cinereel/service dev:bootstrap",
    "dev:ui": "pnpm --filter ui dev",
    "dev:service": "pnpm --filter @cinereel/service dev",
    "dev:ui:peer": "pnpm --filter ui dev:peer",
    "dev:service:peer": "pnpm --filter @cinereel/service dev:peer",
    "build": "pnpm --filter ui build",
    "start": "pnpm --filter @cinereel/service start",
    "test:service": "pnpm --filter @cinereel/service test"
  },
  "author": "Sarphura",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.25.0",
  "devDependencies": {
    "@types/node": "^25.3.2",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
