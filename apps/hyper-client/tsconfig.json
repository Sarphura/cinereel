{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "outDir": "dist",
    "strictPropertyInitialization": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "types": ["node"],
    "paths": {
      "@hyper.api/*": ["./src/hyper.api/*"],
      "@hyper.infrastructure/*": ["./src/hyper.infrastructure/*"],
      "@hyper.implementation/*": ["./src/hyper.implementation/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
