{
  "name": "@cinereel/hyper-client",
  "version": "0.0.2",
  "description": "Hyper SDK (Corestore/Hyperdrive/Hyperswarm) REST Hyper Client for CineReel.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "SIDECAR_ENV_FILE=.env.development NODE_ENV=development node --env-file-if-exists=.env.development --enable-source-maps --watch --import tsx/esm src/main.ts",
    "dev:peer": "SIDECAR_ENV_FILE=.env.peer NODE_ENV=development node --env-file-if-exists=.env.development --env-file-if-exists=.env.peer --enable-source-maps --watch --import tsx/esm src/main.ts",
    "dev:bootstrap": "SIDECAR_ENV_FILE=.env.bootstrap NODE_ENV=development node --env-file-if-exists=.env.bootstrap --enable-source-maps --import tsx/esm src/main.ts",
    "start": "node --enable-source-maps dist/main.js",
    "start:prod": "SIDECAR_ENV_FILE=.env.production NODE_ENV=production node --enable-source-maps dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:sdk-boundary": "node ../../scripts/check-sdk-boundary.mjs",
    "test:openapi:snapshot": "UPDATE_SNAPSHOT=1 pnpm test -- test/openapi.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "hyper-sdk": "^6.2.2",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^4.3.1",
    "pino": "^9.6.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^11.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.3",
    "openapi-types": "^12.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
