{
  "name": "@cinereel/hyper-client",
  "version": "0.0.2",
  "description": "Hyper SDK (Corestore/Hyperdrive/Hyperswarm) REST Hyper Client for Cinereel.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nest start --watch --path tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "11.2.3",
    "@nestjs/swagger": "^11.4.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "content-disposition": "^1.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "hyper-sdk": "^6.2.2",
    "hyperdrive": "^13.3.3",
    "mime-types": "^2.1.35",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.16.1",
    "@types/content-disposition": "^0.5.8",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.1.0",
    "openapi-types": "^12.1.3",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.0.18"
  }
}
