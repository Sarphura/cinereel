{
  "name": "@cinereel/sidecar",
  "version": "0.0.1",
  "description": "Hyper SDK (Corestore/Hyperdrive/Hyperswarm) REST sidecar for CineReel.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "SIDECAR_ENV_FILE=.env.dev NODE_ENV=development node --env-file-if-exists=.env.development --env-file-if-exists=.env.dev --enable-source-maps --watch --import tsx/esm src/index.ts",
    "dev:peer": "SIDECAR_ENV_FILE=.env.peer NODE_ENV=development node --env-file-if-exists=.env.development --env-file-if-exists=.env.peer --enable-source-maps --watch --import tsx/esm src/index.ts",
    "dev:bootstrap": "SIDECAR_ENV_FILE=.env.bootstrap NODE_ENV=development node --env-file-if-exists=.env.bootstrap --enable-source-maps --import tsx/esm src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "start:prod": "SIDECAR_ENV_FILE=.env.production NODE_ENV=production node --env-file-if-exists=.env --env-file-if-exists=.env.production --enable-source-maps dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:sdk-boundary": "bash scripts/check-sdk-boundary.sh"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^6.0.0",
    "fastify": "^5.0.0",
    "hyper-sdk": "^6.2.2",
    "pino": "^9.6.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}