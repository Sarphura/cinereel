# Development defaults for `pnpm run dev` (main instance).
# Tracked in git so the team always has a working dev setup. DO NOT put real
# secrets here — only placeholders that satisfy `>=16 chars` and let the
# sidecar boot with its dev fallback. .env in the same directory still wins
# when present (use it for personal overrides).

SIDECAR_TOKEN=89E0C8F4-132A-5FD3-6E39-855DA8529DE8
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=4321
SIDECAR_STORE_DIR=./.sidecar-store
SIDECAR_SWARM_PORT=0
SIDECAR_LOG_LEVEL=info
SIDECAR_BOOTSTRAP=127.0.0.1:9000