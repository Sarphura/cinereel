  "components": {
    "schemas": {
      "AnnounceRequest": {
        "required": [
          "wait"
        ],
        "type": "object",
        "properties": {
          "wait": {
            "type": "boolean"
          }
        }
      },
      "AutoPackRequest": {
        "required": [
          "localVideoPath",
          "driveName",
          "nfoTitle",
          "nfoYear",
          "imdbId",
          "posterPath"
        ],
        "type": "object",
        "properties": {
          "localVideoPath": {
            "type": "string"
          },
          "driveName": {
            "type": "string"
          },
          "nfoTitle": {
            "type": "string"
          },
          "nfoYear": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32",
            "nullable": true
          },
          "imdbId": {
            "type": "string",
            "nullable": true
          },
          "posterPath": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CreateDriveRequest": {
        "required": [
          "name",
          "type"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "CreateSubscriptionRequest": {
        "required": [
          "key",
          "type"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "ProfileUpdateRequest": {
        "required": [
          "name",
          "bio"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "bio": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "SubscriptionService_ProfilePickerRequest": {
        "required": [
          "profileKey",
          "driveKey"
        ],
        "type": "object",
        "properties": {
          "profileKey": {
            "type": "string"
          },
          "driveKey": {
            "type": "string"
          }
        }
      },
      "VersionResponse": {
        "required": [
          "service",
          "version",
          "apiVersion",
          "runtime",
          "builtAt",
          "commit"
        ],
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "apiVersion": {
            "type": "string"
          },
          "runtime": {
            "type": "string"
          },
          "builtAt": {
            "type": "string",
            "format": "date-time"
          },
          "commit": {
            "type": "string"
          }
        }
      }
    }
  },
