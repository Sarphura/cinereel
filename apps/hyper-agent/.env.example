# ----------------------------------------------------------------------------
# CineReel sidecar — environment configuration
# ----------------------------------------------------------------------------
#
# Copy this file to `.env` for a local dev instance, or to `.env.production`
# for a deployed instance. The sidecar scripts pick the right file based on
# NODE_ENV (see the matrix at the bottom of this file).
#
# Node's built-in --env-file (Node 20.6+) loads these into process.env before
# `src/index.ts` (or compiled `dist/index.js`) starts parsing config. Do NOT
# commit a real `.env` — it is already covered by .gitignore.
#
# Validation rules (enforced by src/config.ts):
#   - SIDECAR_TOKEN must be at least 16 characters
#   - In production, SIDECAR_TOKEN must NOT be the dev placeholder
# ----------------------------------------------------------------------------

# ---------- Auth ------------------------------------------------------------
#
# PRODUCTION: Use SIDECAR_API_KEYS (comma-separated "kid:secret" pairs).
#   Each secret must be at least 16 characters.
#   Generate a key: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#   Example: SIDECAR_API_KEYS=key1:your32bytehexsecret0000000,key2:another32bytehexsec
#
#   Auth flow:
#     1. POST /v1/auth/token  { "apiKey": "your32bytehexsecret0000000" }
#     2. Receive: { "token": "<JWT>", "expiresIn": 900 }
#     3. All /v1/* requests:  Authorization: Bearer <JWT>
#     4. JWT expires after 15 minutes — re-authenticate as needed.
#
# DEVELOPMENT: SIDECAR_TOKEN still works as a legacy fallback.
#   All /v1/* requests:  X-Sidecar-Token: <value>
#   X-Sidecar-Token is NOT accepted in production (NODE_ENV=production).
#
SIDECAR_TOKEN=replace-me-with-at-least-16-random-chars

# Uncomment and fill for production deployments:
# SIDECAR_API_KEYS=key1:your32bytehexsecret00000000000000000000

# ---------- HTTP server ----------------------------------------------------
# Loopback by default — never expose this directly to the internet.
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=4321

# ---------- Storage --------------------------------------------------------
# Where the Corestore keeps its rocksdb database. Multiple sidecar instances
# must use distinct directories (the `dev:peer` script uses ./.peer-sidecar-store).
SIDECAR_STORE_DIR=./.sidecar-store

# ---------- Hyperswarm (P2P) ----------------------------------------------
# 0 = let the OS pick a free UDP port. Set explicitly if you are running
# multiple sidecars on the same host and want stable firewall rules.
SIDECAR_SWARM_PORT=0

# Optional comma-separated bootstrap peers (host:port format). Leave empty for
# pure local dev; populate for deployments that need to find each other
# across NATs via a known relay.
# SIDECAR_BOOTSTRAP=relay.example.com:4321,another.example.com:4321

# ---------- Observability --------------------------------------------------
# pino log level: fatal | error | warn | info | debug | trace | silent
SIDECAR_LOG_LEVEL=info

# ---------- Lifecycle ------------------------------------------------------
# How long graceful shutdown has to drain before SIGKILL.
SIDECAR_SHUTDOWN_TIMEOUT_MS=30000

# ---------- Mode ----------------------------------------------------------
# Affects validation only — leave unset locally, set to "production" on a
# deployed instance. The dev:scripts in package.json set this for you.
# NODE_ENV=development


# ============================================================================
# File matrix (applied automatically by the scripts in package.json):
#
#   pnpm run dev         -> NODE_ENV=development, loads .env (fallback .env.development)
#   pnpm run dev:peer    -> NODE_ENV=development, loads .env.peer (fallback .env)
#   pnpm run start       -> NODE_ENV=production,  loads .env.production
#
# Override the env file path explicitly by setting SIDECAR_ENV_FILE before
# invoking the script.
# ============================================================================
